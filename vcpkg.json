{
  "name": "procedural-terrain-generator",
  "version-string": "0.1.0",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    "cgltf",
    "doctest",
    "glm",
    "lodepng",
    "meshoptimizer",
    "nlohmann-json",
    "stb",
    {
      "name": "tiff",
      "default-features": false,
      "features": [ "zip" ]
    },
    "zlib"
  ],
  "features": {
    "app": {
      "description": "OpenGL desktop application",
      "dependencies": [
        "glew",
        "glfw3",
        {
          "name": "imgui",
          "features": [ "glfw-binding", "opengl3-binding" ]
        },
        "implot"
      ]
    }
  }
}
